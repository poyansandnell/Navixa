# Navixa — client environment variables (example / no real values).
#
# Only EXPO_PUBLIC_* variables are exposed to the client bundle. NEVER put the
# Supabase service_role key or any secret here — it would ship to every user.
# On Replit these are provided via the workspace Secrets / userenv; copy this
# file to `.env` for local (non-Replit) development.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
# App environment: development | preview | production
EXPO_PUBLIC_APP_ENV=development

# Supabase project (client uses the ANON key only; RLS + Edge Functions enforce
# everything sensitive). See SUPABASE_SETUP.md.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ---------------------------------------------------------------------------
# Public URLs surfaced in the legal / settings screens (app/legal/[page].tsx)
# ---------------------------------------------------------------------------
EXPO_PUBLIC_APP_URL=https://fleetarena.example.com
EXPO_PUBLIC_WEBSITE_URL=https://fleetarena.example.com
EXPO_PUBLIC_PRIVACY_URL=https://fleetarena.example.com/privacy
EXPO_PUBLIC_TERMS_URL=https://fleetarena.example.com/terms
EXPO_PUBLIC_SUPPORT_URL=https://fleetarena.example.com/support
EXPO_PUBLIC_SUPPORT_EMAIL=support@fleetarena.example.com
EXPO_PUBLIC_COMMUNITY_URL=https://fleetarena.example.com/community
EXPO_PUBLIC_FAIRPLAY_URL=https://fleetarena.example.com/fair-play
EXPO_PUBLIC_LICENSES_URL=https://fleetarena.example.com/licenses
EXPO_PUBLIC_DATA_DELETION_URL=https://fleetarena.example.com/data-deletion

# ---------------------------------------------------------------------------
# Observability (optional)
# ---------------------------------------------------------------------------
# Sentry DSN for crash/error reporting. Leave blank to disable.
EXPO_PUBLIC_SENTRY_DSN=

# ---------------------------------------------------------------------------
# Server-side ONLY (do NOT prefix with EXPO_PUBLIC_, do NOT ship to client).
# On Supabase these are auto-injected into the Edge Function runtime; listed
# here only for local `supabase functions serve` / self-hosting reference.
# ---------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=service-role-key-server-side-only
